/* =====================================================================
 *  Citizen records (JOptionPane module)
 * ===================================================================== */
class CitizenRecords {

    private static String ask(Component parent, String prompt) {
        while (true) {
            String s = JOptionPane.showInputDialog(parent, prompt, "ESerbisyoPH",
                    JOptionPane.QUESTION_MESSAGE);
            if (s == null) return null;               // Cancel
            if (!s.trim().isEmpty()) return s.trim();
            JOptionPane.showMessageDialog(parent, "This field cannot be empty.");
        }
    }

    private static Integer askInt(Component parent, String prompt, int min, int max) {
        while (true) {
            String s = ask(parent, prompt);
            if (s == null) return null;
            try {
                int n = Integer.parseInt(s);
                if (n >= min && n <= max) return n;
            } catch (NumberFormatException ignored) { }
            JOptionPane.showMessageDialog(parent,
                    "Please enter a number from " + min + " to " + max + ".");
        }
    }

    static void run(Component parent) {
        Integer total = askInt(parent, "ESerbisyoPH\n\nHow many citizen records will you enter?", 1, 100);
        if (total == null) return;

        StringBuilder report = new StringBuilder();
        report.append("=========== ESERBISYOPH ===========\n")
              .append("      REPORTS AND ANALYTICS\n")
              .append("==================================\n\n")
              .append("TOTAL RECORDS: ").append(total).append("\n\n");

        for (int i = 1; i <= total; i++) {
            String name = ask(parent, "Enter Full Name #" + i);
            if (name == null) return;
            Integer age = askInt(parent, "Enter Age", 0, 120);
            if (age == null) return;
            String sex = ask(parent, "Enter Sex (Male/Female)");
            if (sex == null) return;
            String civil = ask(parent, "Enter Civil Status");
            if (civil == null) return;
            String address = ask(parent, "Enter Address");
            if (address == null) return;
            String email = ask(parent, "Enter Email Address");
            if (email == null) return;
            String job = ask(parent, "Enter Employment Status");
            if (job == null) return;

            report.append("Citizen #").append(i).append("\n")
                  .append("Name: ").append(name).append("\n")
                  .append("Age: ").append(age).append("\n")
                  .append("Sex: ").append(sex).append("\n")
                  .append("Civil Status: ").append(civil).append("\n")
                  .append("Address: ").append(address).append("\n")
                  .append("Email: ").append(email).append("\n")
                  .append("Employment: ").append(job).append("\n")
                  .append("----------------------------------\n");
        }

        JTextArea area = new JTextArea(report.toString());
        area.setEditable(false);
        JScrollPane sp = new JScrollPane(area);
        sp.setPreferredSize(new Dimension(450, 400));
        JOptionPane.showMessageDialog(parent, sp,
                "ESerbisyoPH Reports and Analytics", JOptionPane.INFORMATION_MESSAGE);
    }
}

