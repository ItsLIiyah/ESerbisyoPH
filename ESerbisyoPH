class Resident {
    private final String residentID;
    private String firstName, lastName, gender, address, contactNumber;
    private int age;

    Resident(String id, String firstName, String lastName, int age,
             String gender, String address, String contactNumber) {
        this.residentID = id;
        update(firstName, lastName, age, gender, address, contactNumber);
    }

    String getResidentID() { return residentID; }
    String getFirstName() { return firstName; }
    String getLastName() { return lastName; }
    int getAge() { return age; }
    String getGender() { return gender; }
    String getAddress() { return address; }
    String getContactNumber() { return contactNumber; }

    void update(String firstName, String lastName, int age,
                String gender, String address, String contactNumber) {
        this.firstName = firstName;
        this.lastName = lastName;
        this.age = age;
        this.gender = gender;
        this.address = address;
        this.contactNumber = contactNumber;
    }
}

class ResidentBackend {
    private final ArrayList<Resident> residents = new ArrayList<>();

    boolean addResident(Resident resident) {
        if (searchResident(resident.getResidentID()) != null) return false;
        residents.add(resident);
        return true;
    }

    ArrayList<Resident> getResidents() { return residents; }

    Resident searchResident(String id) {
        for (Resident r : residents) {
            if (r.getResidentID().equalsIgnoreCase(id)) return r;
        }
        return null;
    }

    boolean updateResident(String id, String fn, String ln, int age,
                           String gender, String address, String contact) {
        Resident r = searchResident(id);
        if (r == null) return false;
        r.update(fn, ln, age, gender, address, contact);
        return true;
    }

    boolean deleteResident(String id) {
        Resident r = searchResident(id);
        return r != null && residents.remove(r);
    }
}

