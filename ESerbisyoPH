        JPanel topPanel = new JPanel(new BorderLayout(10, 10));
        topPanel.setBorder(BorderFactory.createEmptyBorder(0, 15, 10, 15));
        topPanel.add(formPanel, BorderLayout.CENTER);
        topPanel.add(buttonPanel, BorderLayout.SOUTH);

        JPanel centerPanel = new JPanel(new BorderLayout(10, 10));
        centerPanel.add(topPanel, BorderLayout.CENTER);
        centerPanel.add(searchPanel, BorderLayout.SOUTH);
        add(centerPanel, BorderLayout.CENTER);

        String[] columns = {"Resident ID", "First Name", "Last Name",
                            "Age", "Gender", "Address", "Contact Number"};
        model = new DefaultTableModel(columns, 0) {
            @Override public boolean isCellEditable(int r, int c) { return false; }
        };
        tblResidents = new JTable(model);
        tblResidents.setRowHeight(25);
        JScrollPane scrollPane = new JScrollPane(tblResidents);
        scrollPane.setBorder(BorderFactory.createTitledBorder("Registered Residents"));
        scrollPane.setPreferredSize(new Dimension(900, 200));
        add(scrollPane, BorderLayout.SOUTH);

        btnRegister.addActionListener(e -> registerResident());
        btnUpdate.addActionListener(e -> updateResident());
        btnDelete.addActionListener(e -> deleteResident());
        btnClear.addActionListener(e -> clearForm());
        btnSearch.addActionListener(e -> searchResident(txtSearch.getText()));
        btnShowAll.addActionListener(e -> displayResidents());

        tblResidents.getSelectionModel().addListSelectionListener(e -> {
            if (e.getValueIsAdjusting()) return;
            int row = tblResidents.getSelectedRow();
            if (row == -1) return;
            txtID.setText(model.getValueAt(row, 0).toString());
            txtFirstName.setText(model.getValueAt(row, 1).toString());
            txtLastName.setText(model.getValueAt(row, 2).toString());
            txtAge.setText(model.getValueAt(row, 3).toString());
            cmbGender.setSelectedItem(model.getValueAt(row, 4).toString());
            txtAddress.setText(model.getValueAt(row, 5).toString());
            txtContact.setText(model.getValueAt(row, 6).toString());
        });
    }

    private boolean validateForm() {
        if (txtID.getText().trim().isEmpty() || txtFirstName.getText().trim().isEmpty()
                || txtLastName.getText().trim().isEmpty() || txtAge.getText().trim().isEmpty()
                || txtAddress.getText().trim().isEmpty() || txtContact.getText().trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please fill in all fields.");
            return false;
        }
        if (!txtFirstName.getText().trim().matches("[a-zA-Z .'-]+")
                || !txtLastName.getText().trim().matches("[a-zA-Z .'-]+")) {
            JOptionPane.showMessageDialog(this, "Please enter valid names.");
            return false;
        }
        try {
            int age = Integer.parseInt(txtAge.getText().trim());
            if (age < 1 || age > 120) {
                JOptionPane.showMessageDialog(this, "Age must be between 1 and 120.");
                return false;
            }
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(this, "Please enter a valid age.");
            return false;
        }
        if (!txtContact.getText().trim().matches("[0-9]{10,11}")) {
            JOptionPane.showMessageDialog(this, "Contact number must contain 10 or 11 digits.");
            return false;
        }
        return true;
    }

    private void registerResident() {
        if (!validateForm()) return;
        Resident r = new Resident(txtID.getText().trim(), txtFirstName.getText().trim(),
                txtLastName.getText().trim(), Integer.parseInt(txtAge.getText().trim()),
                cmbGender.getSelectedItem().toString(), txtAddress.getText().trim(),
                txtContact.getText().trim());
        if (backend.addResident(r)) {
            JOptionPane.showMessageDialog(this, "Resident registered successfully!");
            displayResidents();
            clearForm();
        } else {
            JOptionPane.showMessageDialog(this, "Resident ID already exists.");
        }
    }

    private void addRow(Resident r) {
        model.addRow(new Object[]{r.getResidentID(), r.getFirstName(), r.getLastName(),
                r.getAge(), r.getGender(), r.getAddress(), r.getContactNumber()});
    }

    private void displayResidents() {
        model.setRowCount(0);
        for (Resident r : backend.getResidents()) addRow(r);
    }

    private void searchResident(String id) {
        if (id.trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please enter a Resident ID.");
            return;
        }
        Resident r = backend.searchResident(id.trim());
        model.setRowCount(0);
        if (r != null) {
            addRow(r);
        } else {
            JOptionPane.showMessageDialog(this, "Resident not found.");
            displayResidents();
        }
    }

    private void updateResident() {
        if (!validateForm()) return;
        boolean ok = backend.updateResident(txtID.getText().trim(), txtFirstName.getText().trim(),
                txtLastName.getText().trim(), Integer.parseInt(txtAge.getText().trim()),
                cmbGender.getSelectedItem().toString(), txtAddress.getText().trim(),
                txtContact.getText().trim());
        if (ok) {
            JOptionPane.showMessageDialog(this, "Resident updated successfully!");
            displayResidents();
            clearForm();
        } else {
            JOptionPane.showMessageDialog(this, "Resident ID not found. Select a resident first.");
        }
    }

    private void deleteResident() {
        String id = txtID.getText().trim();
        if (id.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please select a resident first.");
            return;
        }
        int confirm = JOptionPane.showConfirmDialog(this,
                "Are you sure you want to delete this resident?",
                "Confirm Delete", JOptionPane.YES_NO_OPTION);
        if (confirm == JOptionPane.YES_OPTION) {
            if (backend.deleteResident(id)) {
                JOptionPane.showMessageDialog(this, "Resident deleted successfully!");
                displayResidents();
                clearForm();
            } else {
                JOptionPane.showMessageDialog(this, "Resident not found.");
            }
        }
    }

    private void clearForm() {
        tblResidents.clearSelection();
        txtID.setText("");
        txtFirstName.setText("");
        txtLastName.setText("");
        txtAge.setText("");
        txtAddress.setText("");
        txtContact.setText("");
        cmbGender.setSelectedIndex(0);
        txtID.requestFocus();
    }
}

