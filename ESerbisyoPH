        for (FoodMenuItem m : menu) {
            menuTableModel.addRow(new Object[]{m.getId(), m.getDetails(), m.getName(),
                    String.format("%.2f", m.getPrice())});
        }

        JPanel leftPanel = new JPanel(new BorderLayout());
        leftPanel.setBorder(BorderFactory.createTitledBorder("Menu"));
        leftPanel.add(new JScrollPane(menuTable), BorderLayout.CENTER);

        JPanel addPanel = new JPanel(new FlowLayout());
        JTextField txtQty = new JTextField("1", 3);
        JButton btnAdd = new JButton("Add to Cart");
        btnAdd.addActionListener(e -> {
            int row = menuTable.getSelectedRow();
            if (row == -1) {
                JOptionPane.showMessageDialog(this, "Please select a menu item.", "Warning", JOptionPane.WARNING_MESSAGE);
                return;
            }
            try {
                int qty = Integer.parseInt(txtQty.getText().trim());
                if (qty <= 0) {
                    JOptionPane.showMessageDialog(this, "Quantity must be greater than 0.", "Error", JOptionPane.ERROR_MESSAGE);
                    return;
                }
                int id = (int) menuTableModel.getValueAt(row, 0);
                for (FoodMenuItem m : menu) {
                    if (m.getId() == id) {
                        currentOrder.addItem(m, qty);
                        break;
                    }
                }
                refreshCartTable();
            } catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(this, "Enter a valid number for quantity.", "Error", JOptionPane.ERROR_MESSAGE);
            }
        });
        addPanel.add(new JLabel("Qty:"));
        addPanel.add(txtQty);
        addPanel.add(btnAdd);
        leftPanel.add(addPanel, BorderLayout.SOUTH);

        cartTableModel = readOnly(new String[]{"Item", "Qty", "Subtotal (P)"});
        JTable cartTable = new JTable(cartTableModel);

        JPanel rightPanel = new JPanel(new BorderLayout());
        rightPanel.setBorder(BorderFactory.createTitledBorder("Current Order"));
        rightPanel.add(new JScrollPane(cartTable), BorderLayout.CENTER);

        lblCartTotal = new JLabel("TOTAL: P0.00");
        lblCartTotal.setFont(new Font("Arial", Font.BOLD, 14));
        JButton btnCheckout = new JButton("Checkout & Pay");
        btnCheckout.addActionListener(e -> checkout());

        JPanel checkoutPanel = new JPanel(new BorderLayout());
        checkoutPanel.add(lblCartTotal, BorderLayout.NORTH);
        checkoutPanel.add(btnCheckout, BorderLayout.CENTER);
        rightPanel.add(checkoutPanel, BorderLayout.SOUTH);

        JSplitPane split = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, leftPanel, rightPanel);
        split.setDividerLocation(420);
        panel.add(split, BorderLayout.CENTER);
        return panel;
    }

    private void checkout() {
        if (currentOrder.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Cart is empty.", "Warning", JOptionPane.WARNING_MESSAGE);
            return;
        }
        String cashStr = JOptionPane.showInputDialog(this,
                String.format("Total Amount: P%.2f\nEnter cash received:", currentOrder.getTotal()),
                "Payment", JOptionPane.QUESTION_MESSAGE);
        if (cashStr == null) return;
        try {
            double cash = Double.parseDouble(cashStr.trim());
            if (Double.isNaN(cash) || Double.isInfinite(cash) || cash <= 0) {
                throw new NumberFormatException();
            }
            CashPayment payment = new CashPayment();
            payment.setCash(cash);
            if (payment.pay(currentOrder.getTotal())) {
                JOptionPane.showMessageDialog(this,
                        String.format("Payment Successful!\nChange: P%.2f\nOrder No: %d",
                                payment.getChange(), currentOrder.getOrderId()),
                        "Success", JOptionPane.INFORMATION_MESSAGE);
                orders.add(currentOrder);
                totalSales += currentOrder.getTotal();
                currentOrder = new Order();
                refreshCartTable();
                refreshOrdersTable();
                refreshSalesReport();
            } else {
                JOptionPane.showMessageDialog(this, "Insufficient payment amount.", "Error", JOptionPane.ERROR_MESSAGE);
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Please enter a valid cash amount.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void refreshCartTable() {
        cartTableModel.setRowCount(0);
        for (OrderItem oi : currentOrder.getItems()) {
            cartTableModel.addRow(new Object[]{oi.getItem().getName(), oi.getQuantity(),
                    String.format("%.2f", oi.getSubtotal())});
        }
        lblCartTotal.setText(String.format("TOTAL: P%.2f", currentOrder.getTotal()));
    }

    private JPanel createManageOrdersPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        ordersTableModel = readOnly(new String[]{"Order No.", "Status", "Total (P)"});
        ordersTable = new JTable(ordersTableModel);
        panel.add(new JScrollPane(ordersTable), BorderLayout.CENTER);

        JButton b1 = new JButton("Set to Preparing");
        JButton b2 = new JButton("Set to Ready");
        JButton b3 = new JButton("Set to Completed");
        b1.addActionListener(e -> updateSelectedOrderStatus("Preparing"));
        b2.addActionListener(e -> updateSelectedOrderStatus("Ready"));
        b3.addActionListener(e -> updateSelectedOrderStatus("Completed"));

        JPanel btnPanel = new JPanel(new FlowLayout());
        btnPanel.add(b1); btnPanel.add(b2); btnPanel.add(b3);
        panel.add(btnPanel, BorderLayout.SOUTH);
        return panel;
    }

    private void updateSelectedOrderStatus(String newStatus) {
        int row = ordersTable.getSelectedRow();
        if (row == -1) {
            JOptionPane.showMessageDialog(this, "Please select an order from the table.", "Warning", JOptionPane.WARNING_MESSAGE);
            return;
        }
        int orderId = (int) ordersTableModel.getValueAt(row, 0);
        for (Order o : orders) {
            if (o.getOrderId() == orderId) { o.setStatus(newStatus); break; }
        }
        refreshOrdersTable();
        refreshSalesReport();
    }

    private void refreshOrdersTable() {
        ordersTableModel.setRowCount(0);
        for (Order o : orders) {
            ordersTableModel.addRow(new Object[]{o.getOrderId(), o.getStatus(),
                    String.format("%.2f", o.getTotal())});
        }
    }

    private JPanel createSalesReportPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        lblTotalOrders = new JLabel("Paid Orders: 0");
        lblTotalSales = new JLabel("Total Sales: P0.00");
        lblTotalOrders.setFont(new Font("Arial", Font.BOLD, 14));
        lblTotalSales.setFont(new Font("Arial", Font.BOLD, 14));
        JPanel top = new JPanel(new GridLayout(1, 2));
        top.add(lblTotalOrders);
        top.add(lblTotalSales);
        panel.add(top, BorderLayout.NORTH);

        salesTableModel = readOnly(new String[]{"Order No.", "Status", "Total (P)"});
        panel.add(new JScrollPane(new JTable(salesTableModel)), BorderLayout.CENTER);
        return panel;
    }

    private void refreshSalesReport() {
        salesTableModel.setRowCount(0);
        for (Order o : orders) {
            salesTableModel.addRow(new Object[]{o.getOrderId(), o.getStatus(),
                    String.format("%.2f", o.getTotal())});
        }
        lblTotalOrders.setText("Paid Orders: " + orders.size());
        lblTotalSales.setText(String.format("Total Sales: P%.2f", totalSales));
    }
}

