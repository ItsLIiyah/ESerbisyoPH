class ComplaintData {
    static final ArrayList<User> users = new ArrayList<>();
    static final ArrayList<Complaint> complaints = new ArrayList<>();
    static User currentUser = null;

    static {
        users.add(new User("admin", "admin123", true));   // default admin
    }
}

class User {
    final String username, password;
    final boolean isAdmin;

    User(String username, String password, boolean isAdmin) {
        this.username = username; this.password = password; this.isAdmin = isAdmin;
    }
}

class Complaint {
    final String firstName, lastName, email, date, type, description, screenshotPath;
    String status = "Pending";

    Complaint(String firstName, String lastName, String email, String date,
              String type, String description, String screenshotPath) {
        this.firstName = firstName; this.lastName = lastName; this.email = email;
        this.date = date; this.type = type; this.description = description;
        this.screenshotPath = screenshotPath;
    }

    @Override public String toString() {
        return "Name: " + firstName + " " + lastName +
               "\nEmail: " + email +
               "\nDate: " + date +
               "\nType: " + type +
               "\nStatus: " + status +
               "\nDescription: " + description +
               "\nScreenshot: " + (screenshotPath.isEmpty() ? "None" : screenshotPath) +
               "\n----------------------------------------";
    }
}

class LoginFrame extends JFrame {
    private final JTextField userField = new JTextField();
    private final JPasswordField passField = new JPasswordField();

    LoginFrame() {
        setTitle("Public Service Complaint System - Login");
        setSize(400, 300);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        JLabel title = new JLabel("Login", SwingConstants.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 22));
        add(title, BorderLayout.NORTH);

        JPanel panel = new JPanel(new GridLayout(4, 1, 8, 8));
        panel.setBorder(BorderFactory.createEmptyBorder(20, 40, 20, 40));
        panel.add(new JLabel("Username:"));
        panel.add(userField);
        panel.add(new JLabel("Password:"));
        panel.add(passField);
        add(panel, BorderLayout.CENTER);

        JButton loginBtn = new JButton("Login");
        JButton registerBtn = new JButton("Register");
        loginBtn.addActionListener(e -> login());
        registerBtn.addActionListener(e -> { dispose(); new RegisterFrame(); });

        JPanel btnPanel = new JPanel();
        btnPanel.add(loginBtn);
        btnPanel.add(registerBtn);
        add(btnPanel, BorderLayout.SOUTH);
        setVisible(true);
    }

    private void login() {
        String username = userField.getText().trim();
        String password = new String(passField.getPassword());
        for (User u : ComplaintData.users) {
            if (u.username.equals(username) && u.password.equals(password)) {
                ComplaintData.currentUser = u;
                dispose();
                new DashboardFrame();
                return;
            }
        }
        JOptionPane.showMessageDialog(this, "Wrong username or password!");
    }
}

class RegisterFrame extends JFrame {
    private final JTextField userField = new JTextField();
    private final JPasswordField passField = new JPasswordField();

    RegisterFrame() {
        setTitle("Register");
        setSize(400, 300);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        JLabel title = new JLabel("Create Account", SwingConstants.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 20));
        add(title, BorderLayout.NORTH);

        JPanel panel = new JPanel(new GridLayout(4, 1, 8, 8));
        panel.setBorder(BorderFactory.createEmptyBorder(20, 40, 20, 40));
        panel.add(new JLabel("Username:"));
        panel.add(userField);
        panel.add(new JLabel("Password:"));
        panel.add(passField);
        add(panel, BorderLayout.CENTER);

        JButton registerBtn = new JButton("Register");
        JButton backBtn = new JButton("Back");
        registerBtn.addActionListener(e -> register());
        backBtn.addActionListener(e -> { dispose(); new LoginFrame(); });

        JPanel btnPanel = new JPanel();
        btnPanel.add(registerBtn);
        btnPanel.add(backBtn);
        add(btnPanel, BorderLayout.SOUTH);
        setVisible(true);
    }

    private void register() {
        String username = userField.getText().trim();
        String password = new String(passField.getPassword());
        if (username.isEmpty() || password.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please fill all fields!");
            return;
        }
        for (User u : ComplaintData.users) {
            if (u.username.equals(username)) {
                JOptionPane.showMessageDialog(this, "Username already exists!");
                return;
            }
        }
        ComplaintData.users.add(new User(username, password, false));
        JOptionPane.showMessageDialog(this, "Registration successful!");
        dispose();
        new LoginFrame();
    }
}

class DashboardFrame extends JFrame {

    DashboardFrame() {
        setTitle("Complaint System - Dashboard");
        setSize(500, 380);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        String welcome = "Welcome, " + ComplaintData.currentUser.username;
        if (ComplaintData.currentUser.isAdmin) welcome += " (Administrator)";
        JLabel title = new JLabel(welcome, SwingConstants.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 18));
        title.setBorder(BorderFactory.createEmptyBorder(15, 0, 15, 0));
        add(title, BorderLayout.NORTH);

        JPanel panel = new JPanel(new GridLayout(4, 1, 12, 12));
        panel.setBorder(BorderFactory.createEmptyBorder(10, 60, 20, 60));

        JButton submitBtn = new JButton("Submit Complaint");
        JButton viewBtn = new JButton("View All Complaints");
        JButton reportBtn = new JButton("Reports & Analytics");
        JButton logoutBtn = new JButton("Logout");

        Font f = new Font("Arial", Font.PLAIN, 15);
        for (JButton b : new JButton[]{submitBtn, viewBtn, reportBtn, logoutBtn}) b.setFont(f);

        submitBtn.addActionListener(e -> new SubmitComplaintFrame());
        viewBtn.addActionListener(e -> { if (requireAdmin()) viewComplaints(); });
        reportBtn.addActionListener(e -> { if (requireAdmin()) showReports(); });
        logoutBtn.addActionListener(e -> {
            ComplaintData.currentUser = null;
            dispose();
            new LoginFrame();
        });

        panel.add(submitBtn);
        panel.add(viewBtn);
        panel.add(reportBtn);
        panel.add(logoutBtn);
        add(panel, BorderLayout.CENTER);
        setVisible(true);
    }

    private boolean requireAdmin() {
        if (ComplaintData.currentUser != null && ComplaintData.currentUser.isAdmin) return true;
        JOptionPane.showMessageDialog(this, "Only the administrator can use this feature.");
        return false;
    }

    private void viewComplaints() {
        if (ComplaintData.complaints.isEmpty()) {
            JOptionPane.showMessageDialog(this, "No complaints submitted yet.");
            return;
        }
        StringBuilder sb = new StringBuilder();
        int i = 1;
        for (Complaint c : ComplaintData.complaints) {
            sb.append(i++).append(".\n").append(c).append("\n");
        }
        JTextArea area = new JTextArea(sb.toString());
        area.setEditable(false);
        area.setFont(new Font("Monospaced", Font.PLAIN, 13));
        JScrollPane scroll = new JScrollPane(area);
        scroll.setPreferredSize(new Dimension(500, 380));
        JOptionPane.showMessageDialog(this, scroll, "All Complaints", JOptionPane.INFORMATION_MESSAGE);
    }

    private void showReports() {
        int technical = 0, content = 0, ui = 0, accessibility = 0, other = 0;
        for (Complaint c : ComplaintData.complaints) {
            switch (c.type) {
                case "Technical Issue": technical++; break;
                case "Content Error": content++; break;
                case "User Interface Problem": ui++; break;
                case "Accessibility Issue": accessibility++; break;
                default: other++;
            }
        }
        String report = "========== COMPLAINT REPORTS ==========\n\n"
                + "Total Complaints          : " + ComplaintData.complaints.size() + "\n\n"
                + "Technical Issue           : " + technical + "\n"
                + "Content Error             : " + content + "\n"
                + "User Interface Problem    : " + ui + "\n"
                + "Accessibility Issue       : " + accessibility + "\n"
                + "Other                     : " + other + "\n";
        JOptionPane.showMessageDialog(this, report, "Reports & Analytics", JOptionPane.INFORMATION_MESSAGE);
    }
}

class SubmitComplaintFrame extends JFrame {

    private final JTextField firstNameField = new JTextField(), lastNameField = new JTextField(),
            emailField = new JTextField(), dateField = new JTextField();
    private final JRadioButton techBtn = new JRadioButton("Technical Issue"),
            contentBtn = new JRadioButton("Content Error"),
            uiBtn = new JRadioButton("User Interface Problem"),
            accessBtn = new JRadioButton("Accessibility Issue"),
            otherBtn = new JRadioButton("Other");
    private final JTextArea descArea = new JTextArea(4, 20);
    private final JLabel fileLabel = new JLabel("No file selected");
    private final JLabel imagePreviewLabel =
            new JLabel("Image preview will appear here", SwingConstants.CENTER);
    private String selectedFilePath = "";

    SubmitComplaintFrame() {
        setTitle("Website Complaint Form");
        setSize(550, 750);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        JLabel title = new JLabel("Website Complaint Form", SwingConstants.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 22));
        title.setBorder(BorderFactory.createEmptyBorder(15, 0, 5, 0));
        add(title, BorderLayout.NORTH);

        JPanel form = new JPanel();
        form.setLayout(new BoxLayout(form, BoxLayout.Y_AXIS));
        form.setBorder(BorderFactory.createEmptyBorder(10, 30, 10, 30));

        form.add(createLabel("Full Name"));
        JPanel namePanel = new JPanel(new GridLayout(1, 2, 10, 0));
        namePanel.setAlignmentX(Component.LEFT_ALIGNMENT);
        namePanel.add(createFieldWithHint(firstNameField, "First Name"));
        namePanel.add(createFieldWithHint(lastNameField, "Last Name"));
        form.add(namePanel);
        form.add(Box.createVerticalStrut(10));

        form.add(createLabel("Email Address"));
        form.add(createFieldWithHint(emailField, "example@example.com"));
        form.add(Box.createVerticalStrut(10));

        form.add(createLabel("Date of Incident"));
        form.add(createFieldWithHint(dateField, "MM-DD-YYYY"));
        form.add(Box.createVerticalStrut(10));

        form.add(createLabel("Type of Complaint"));
        ButtonGroup group = new ButtonGroup();
        JPanel radioPanel = new JPanel();
        radioPanel.setLayout(new BoxLayout(radioPanel, BoxLayout.Y_AXIS));
        radioPanel.setAlignmentX(Component.LEFT_ALIGNMENT);
        for (JRadioButton rb : new JRadioButton[]{techBtn, contentBtn, uiBtn, accessBtn, otherBtn}) {
            group.add(rb);
            radioPanel.add(rb);
        }
        techBtn.setSelected(true);
        form.add(radioPanel);
        form.add(Box.createVerticalStrut(10));

        form.add(createLabel("Description of the Complaint"));
        descArea.setLineWrap(true);
        descArea.setWrapStyleWord(true);
        JScrollPane scroll = new JScrollPane(descArea);
        scroll.setMaximumSize(new Dimension(Integer.MAX_VALUE, 100));
        scroll.setAlignmentX(Component.LEFT_ALIGNMENT);
        form.add(scroll);
        form.add(Box.createVerticalStrut(10));

        form.add(createLabel("Upload Screenshot (if any)"));
        JButton fileBtn = new JButton("Choose File");
        fileBtn.addActionListener(e -> chooseFile());
        JPanel filePanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        filePanel.add(fileBtn);
        filePanel.add(fileLabel);
        filePanel.setAlignmentX(Component.LEFT_ALIGNMENT);
        form.add(filePanel);

        Dimension prev = new Dimension(220, 150);
        imagePreviewLabel.setPreferredSize(prev);
        imagePreviewLabel.setMinimumSize(prev);
        imagePreviewLabel.setMaximumSize(prev);
        imagePreviewLabel.setBorder(BorderFactory.createLineBorder(Color.LIGHT_GRAY));
        imagePreviewLabel.setAlignmentX(Component.LEFT_ALIGNMENT);
        form.add(Box.createVerticalStrut(8));
        form.add(imagePreviewLabel);

        JScrollPane mainScroll = new JScrollPane(form);
        mainScroll.setBorder(null);
        add(mainScroll, BorderLayout.CENTER);

        JButton submitBtn = new JButton("Submit");
        submitBtn.setBackground(new Color(0, 150, 0));
        submitBtn.setForeground(Color.WHITE);
        submitBtn.setFont(new Font("Arial", Font.BOLD, 15));
        submitBtn.setFocusPainted(false);
        submitBtn.addActionListener(e -> submitComplaint());

        JPanel bottom = new JPanel();
        bottom.setBorder(BorderFactory.createEmptyBorder(10, 0, 15, 0));
        bottom.add(submitBtn);
        add(bottom, BorderLayout.SOUTH);
        setVisible(true);
    }

    private JLabel createLabel(String text) {
        JLabel label = new JLabel(text);
        label.setFont(new Font("Arial", Font.BOLD, 13));
        label.setAlignmentX(Component.LEFT_ALIGNMENT);
        return label;
    }

    private JPanel createFieldWithHint(JTextField field, String hint) {
        JPanel p = new JPanel(new BorderLayout());
        field.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(Color.LIGHT_GRAY),
                BorderFactory.createEmptyBorder(5, 8, 5, 8)));
        p.add(field, BorderLayout.CENTER);
        JLabel hintLabel = new JLabel(hint);
        hintLabel.setFont(new Font("Arial", Font.PLAIN, 11));
        hintLabel.setForeground(Color.GRAY);
        p.add(hintLabel, BorderLayout.SOUTH);
        p.setAlignmentX(Component.LEFT_ALIGNMENT);
        p.setMaximumSize(new Dimension(Integer.MAX_VALUE, 55));
        return p;
    }

    private void chooseFile() {
        JFileChooser chooser = new JFileChooser();
        chooser.setFileFilter(new FileNameExtensionFilter(
                "Image files", "jpg", "jpeg", "png", "gif", "bmp"));
        if (chooser.showOpenDialog(this) != JFileChooser.APPROVE_OPTION) return;

        File file = chooser.getSelectedFile();
        selectedFilePath = file.getAbsolutePath();
        fileLabel.setText(file.getName());

        ImageIcon icon = new ImageIcon(selectedFilePath);
        if (icon.getIconWidth() <= 0) {                 // not a readable image
            imagePreviewLabel.setIcon(null);
            imagePreviewLabel.setText("Cannot preview this image");
            return;
        }
        Image img = icon.getImage().getScaledInstance(200, 140, Image.SCALE_SMOOTH);
        imagePreviewLabel.setIcon(new ImageIcon(img));
        imagePreviewLabel.setText("");
    }

    private void submitComplaint() {
        String firstName = firstNameField.getText().trim();
        String lastName = lastNameField.getText().trim();
        String email = emailField.getText().trim();
        String date = dateField.getText().trim();
        String description = descArea.getText().trim();

        if (firstName.isEmpty() || lastName.isEmpty() || email.isEmpty()
                || date.isEmpty() || description.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please fill in all required fields!");
            return;
        }
        if (!email.matches("^[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+$")) {
            JOptionPane.showMessageDialog(this, "Please enter a valid email address.");
            return;
        }
        if (!date.matches("^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])-\\d{4}$")) {
            JOptionPane.showMessageDialog(this, "Date must be in MM-DD-YYYY format.");
            return;
        }

        String type = "Other";
        if (techBtn.isSelected()) type = "Technical Issue";
        else if (contentBtn.isSelected()) type = "Content Error";
        else if (uiBtn.isSelected()) type = "User Interface Problem";
        else if (accessBtn.isSelected()) type = "Accessibility Issue";

        ComplaintData.complaints.add(new Complaint(firstName, lastName, email,
                date, type, description, selectedFilePath));
        JOptionPane.showMessageDialog(this,
                "Complaint submitted successfully!\nThank you for your feedback.");
        dispose();
    }
}

