abstract class FoodMenuItem {
    private final int id;
    private final String name;
    private final double price;

    FoodMenuItem(int id, String name, double price) {
        this.id = id; this.name = name; this.price = price;
    }
    int getId() { return id; }
    String getName() { return name; }
    double getPrice() { return price; }
    abstract String getDetails();
}

class FoodItem extends FoodMenuItem {
    FoodItem(int id, String name, double price) { super(id, name, price); }
    String getDetails() { return "[FOOD]"; }
}

class BeverageItem extends FoodMenuItem {
    BeverageItem(int id, String name, double price) { super(id, name, price); }
    String getDetails() { return "[DRINK]"; }
}

class OrderItem {
    private final FoodMenuItem item;
    private final int quantity;

    OrderItem(FoodMenuItem item, int quantity) { this.item = item; this.quantity = quantity; }
    FoodMenuItem getItem() { return item; }
    int getQuantity() { return quantity; }
    double getSubtotal() { return item.getPrice() * quantity; }
}

interface Payable {
    boolean pay(double amount);
}

class CashPayment implements Payable {
    private double cash;
    private double change;

    public boolean pay(double amount) {
        if (cash < amount) return false;
        change = cash - amount;
        return true;
    }
    void setCash(double cash) { this.cash = cash; }
    double getChange() { return change; }
}

class Order {
    private static int nextId = 1001;
    private final int orderId = nextId++;
    private final List<OrderItem> items = new ArrayList<>();
    private String status = "Preparing";

    int getOrderId() { return orderId; }
    String getStatus() { return status; }
    void setStatus(String status) { this.status = status; }
    boolean isEmpty() { return items.isEmpty(); }
    List<OrderItem> getItems() { return items; }

    void addItem(FoodMenuItem item, int quantity) {
        if (quantity > 0) items.add(new OrderItem(item, quantity));
    }

    double getTotal() {
        double total = 0;
        for (OrderItem oi : items) total += oi.getSubtotal();
        return total;
    }
}

