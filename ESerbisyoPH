/* ---------- Government services (abstraction / polymorphism) ---------- */
abstract class GovernmentService {
    private final String name;
    private final String description;

    GovernmentService(String name, String description) {
        this.name = name;
        this.description = description;
    }

    String getName() { return name; }
    String getDescription() { return description; }
    abstract String getDetails();
}

class HealthService extends GovernmentService {
    HealthService() { super("Health Services", "Access public health information and services."); }
    String getDetails() { return "Health: Medical assistance, health programs, and public healthcare information."; }
}

class EducationService extends GovernmentService {
    EducationService() { super("Education Services", "Explore educational programs and assistance."); }
    String getDetails() { return "Education: Scholarships, school programs, and educational assistance."; }
}

class PublicSafetyService extends GovernmentService {
    PublicSafetyService() { super("Public Safety", "Find emergency information and safety programs."); }
    String getDetails() { return "Public Safety: Emergency contacts, community safety, and disaster preparedness."; }
}

class SocialService extends GovernmentService {
    SocialService() { super("Social Services", "Learn about community support programs."); }
    String getDetails() { return "Social Services: Community assistance, family support, and public welfare programs."; }
}

