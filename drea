package com.mycompany.ESerbisyo_ph;

import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Component;
import java.awt.Dimension;
import java.awt.Font;
import java.awt.GridLayout;
import javax.swing.BorderFactory;
import javax.swing.Box;
import javax.swing.BoxLayout;
import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JTextArea;
import javax.swing.SwingUtilities;

// The main 
public class ESerbisyoPH {

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new ESerbisyoDashboard().setVisible(true);
        });
    }

    //Polymorphism & Encapsulation
    public abstract static class GovernmentService {
        private String name;
        private String description;

        public GovernmentService(String name, String descriptSDion) {
            this.name = name;
            this.description = description;
        }

        public String getName() { return name; }
        public String getDescription() { return description; }
        public abstract String getDetails();
    }

    public static class HealthService extends GovernmentService {
        public HealthService() {
            super("Health Services", "Access public health information and services.");
        }
        @Override
        public String getDetails() {
            return "Health: Medical assistance, health programs, and public healthcare information.";
        }
    }

    public static class EducationService extends GovernmentService {
        public EducationService() {
            super("Education Services", "Explore educational programs and assistance.");
        }
        @Override
        public String getDetails() {
            return "Education: Scholarships, school programs, and educational assistance.";
        }
    }

    public static class PublicSafetyService extends GovernmentService {
        public PublicSafetyService() {
            super("Public Safety", "Find emergency information and safety programs.");
        }
        @Override
        public String getDetails() {
            return "Public Safety: Emergency contacts, community safety, and disaster preparedness.";
        }
    }

    public static class SocialService extends GovernmentService {
        public SocialService() {
            super("Social Services", "Learn about community support programs.");
        }
        @Override
        public String getDetails() {
            return "Social Services: Community assistance, family support, and public welfare programs.";
        }
    }

    public static class ServiceRequest {
        private String citizenName;
        private String requestType;

        public void setCitizenName(String citizenName) { this.citizenName = citizenName; }
        public String getCitizenName() { return citizenName; }
        public void setRequestType(String requestType) { this.requestType = requestType; }
        public String getRequestType() { return requestType; }
    }
}

//  DASHBOARD CLASS 
// (Not public, so it can reside in the same file seamlessly)
class ESerbisyoDashboard extends JFrame {

    private int totalRequests = 0;
    private JLabel requestCount;

    private ESerbisyoPH.GovernmentService[] services = {
        new ESerbisyoPH.HealthService(),
        new ESerbisyoPH.EducationService(),
        new ESerbisyoPH.PublicSafetyService(),
        new ESerbisyoPH.SocialService()
    };

    public ESerbisyoDashboard() {
        setTitle("ESerbisyoPH | Government Agency");
        setSize(1000, 720);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setMinimumSize(new Dimension(700, 600));

        Color navy = new Color(18, 47, 86);
        Color blue = new Color(35, 100, 175);
        Color background = new Color(242, 246, 251);

        JPanel main = new JPanel(new BorderLayout());
        main.setBackground(background);

        // HEADER
        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(navy);
        header.setBorder(BorderFactory.createEmptyBorder(30, 18, 40, 28));

        JLabel logo = new JLabel("ESerbisyoPH ");
        logo.setForeground(Color.WHITE);
        logo.setFont(new Font("Arial", Font.BOLD, 26));

        JLabel tagline = new JLabel("PUBLIC SERVICE • TRANSPARENCY • COMMUNITY");
        tagline.setForeground(Color.WHITE);
        tagline.setFont(new Font("Arial", Font.PLAIN, 11));

        JPanel brand = new JPanel();
        brand.setOpaque(false);
        brand.setLayout(new BoxLayout(brand, BoxLayout.Y_AXIS));
        brand.add(logo);
        brand.add(Box.createVerticalStrut(6));
        brand.add(tagline);

        header.add(brand, BorderLayout.WEST);   

        JButton requestButton = new JButton("Request a Service");
        requestButton.setFont(new Font("Arial", Font.BOLD, 1));
        requestButton.setBackground(Color.WHITE);
        requestButton.setForeground(navy);
        requestButton.setFocusPainted(false);
        requestButton.addActionListener(e -> showRequestForm());

        header.add(requestButton, BorderLayout.EAST);
        main.add(header, BorderLayout.NORTH);

        // PAGE CONTENT
        JPanel content = new JPanel();
        content.setBackground(background);
        content.setBorder(BorderFactory.createEmptyBorder(25, 28, 25, 28));
        content.setLayout(new BoxLayout(content, BoxLayout.Y_AXIS));

        JLabel welcome = new JLabel("Welcome to Your Government Portal");
        welcome.setFont(new Font("Arial", Font.BOLD, 25));
        welcome.setForeground(navy);
        welcome.setAlignmentX(Component.LEFT_ALIGNMENT);

        JLabel intro = new JLabel("Access government services in one convenient place.");
        intro.setFont(new Font("Arial", Font.PLAIN, 14));
        intro.setForeground(new Color(90, 100, 115));
        intro.setAlignmentX(Component.LEFT_ALIGNMENT);

        content.add(welcome);
        content.add(Box.createVerticalStrut(8));
        content.add(intro);
        content.add(Box.createVerticalStrut(22));

        // DASHBOARD SUMMARY
        JPanel dashboard = new JPanel(new GridLayout(1, 2, 15, 0));
        dashboard.setOpaque(false);
        dashboard.setMaximumSize(new Dimension(900, 100));
        dashboard.setAlignmentX(Component.LEFT_ALIGNMENT);

        dashboard.add(createSummaryCard("GOVERNMENT PILLARS", "4", blue));

        JPanel requestsCard = createSummaryCard("SERVICE REQUESTS", "0", new Color(30, 135, 110));
        requestCount = (JLabel) ((JPanel) requestsCard.getComponent(0)).getComponent(1);

        dashboard.add(requestsCard);
        content.add(dashboard);
        content.add(Box.createVerticalStrut(25));

        JLabel pillarTitle = new JLabel("Explore Our Dashboard");
        pillarTitle.setFont(new Font("Arial", Font.BOLD, 20));
        pillarTitle.setForeground(navy);
        pillarTitle.setAlignmentX(Component.LEFT_ALIGNMENT);

        content.add(pillarTitle);
        content.add(Box.createVerticalStrut(14));

        // FOUR SERVICE CARDS
      // Change this line:
       JPanel cards = new JPanel(new GridLayout(2, 2, 15, 15)); 

        cards.setOpaque(false);
        cards.setAlignmentX(Component.LEFT_ALIGNMENT);

        for (ESerbisyoPH.GovernmentService service : services) {
            JPanel card = new JPanel();
            card.setLayout(new BoxLayout(card, BoxLayout.Y_AXIS));
            card.setBackground(Color.WHITE);
            card.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(220, 228, 238)),
                BorderFactory.createEmptyBorder(18, 18, 18, 18)
            ));

            JLabel name = new JLabel(service.getName());
            name.setFont(new Font("Arial", Font.BOLD, 17));
            name.setForeground(navy);

            JTextArea description = new JTextArea(service.getDescription());
            description.setWrapStyleWord(true);
            description.setLineWrap(true);
            description.setEditable(false);
            description.setOpaque(false);
            description.setFont(new Font("Arial", Font.PLAIN, 13));
            description.setForeground(new Color(75, 85, 100));

            JButton learnMore = new JButton("View Services");
            learnMore.setBackground(blue);
            learnMore.setForeground(Color.WHITE);
            learnMore.setFocusPainted(false); 
            learnMore.addActionListener(e -> JOptionPane.showMessageDialog(this, service.getDetails()));

            card.add(name);
            card.add(Box.createVerticalStrut(9));
            card.add(description);
            card.add(Box.createVerticalStrut(13));
            card.add(learnMore);
            cards.add(card);
        }

        content.add(cards);
        main.add(content, BorderLayout.CENTER);
        add(main);
    }

    private JPanel createSummaryCard(String title, String value, Color bgColor) {
        JPanel card = new JPanel(new BorderLayout());
        card.setBackground(bgColor);
        card.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));

        JPanel textPanel = new JPanel();
        textPanel.setOpaque(false);
        textPanel.setLayout(new BoxLayout(textPanel, BoxLayout.Y_AXIS));

        JLabel titleLabel = new JLabel(title);
        titleLabel.setForeground(Color.WHITE);
        titleLabel.setFont(new Font("Arial", Font.PLAIN, 15));

        JLabel valueLabel = new JLabel(value);
        valueLabel.setForeground(Color.WHITE);
        valueLabel.setFont(new Font("Arial", Font.BOLD, 30));

        textPanel.add(titleLabel);
        textPanel.add(Box.createVerticalStrut(4));
        textPanel.add(valueLabel);

        card.add(textPanel, BorderLayout.WEST);
        return card;
    }

    private void showRequestForm() {
    totalRequests++;
    }
}
