
import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;

public class ResidentsRegistrationSystem extends JFrame {

    private JTextField txtResidentID, txtFirstName, txtLastName;
    private JTextField txtAge, txtAddress, txtContact;
    private JComboBox<String> cmbGender;
    private JTable tblResidents;
    private DefaultTableModel model;

    public ResidentsRegistrationSystem() {
        setTitle("Residents Registration System");
        setSize(950, 650);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        // System heading
        JLabel heading = new JLabel(
            "RESIDENTS REGISTRATION SYSTEM",
            SwingConstants.CENTER
        );
        heading.setFont(new Font("Arial", Font.BOLD, 24));
        heading.setBorder(BorderFactory.createEmptyBorder(20, 10, 10, 10));
        add(heading, BorderLayout.NORTH);

        // Registration form
        JPanel formPanel = new JPanel(new GridLayout(7, 2, 10, 10));
        formPanel.setBorder(BorderFactory.createTitledBorder(
            "Resident Information"
        ));

        txtResidentID = new JTextField();
        txtFirstName = new JTextField();
        txtLastName = new JTextField();
        txtAge = new JTextField();
        txtAddress = new JTextField();
        txtContact = new JTextField();

        cmbGender = new JComboBox<>(
            new String[]{"Male", "Female", "Others"}
        );

        formPanel.add(new JLabel("Resident ID:"));
        formPanel.add(txtResidentID);

        formPanel.add(new JLabel("First Name:"));
        formPanel.add(txtFirstName);

        formPanel.add(new JLabel("Last Name:"));
        formPanel.add(txtLastName);

        formPanel.add(new JLabel("Age:"));
        formPanel.add(txtAge);

        formPanel.add(new JLabel("Gender:"));
        formPanel.add(cmbGender);

        formPanel.add(new JLabel("Address:"));
        formPanel.add(txtAddress);

        formPanel.add(new JLabel("Contact Number:"));
        formPanel.add(txtContact);

        // Buttons
        JButton btnRegister = new JButton("Register Resident");
        JButton btnClear = new JButton("Clear Form");
        JButton btnDelete = new JButton("Delete Selected");

        JPanel buttonPanel = new JPanel(new FlowLayout());
        buttonPanel.add(btnRegister);
        buttonPanel.add(btnClear);
        buttonPanel.add(btnDelete);

        JPanel topPanel = new JPanel(new BorderLayout(10, 10));
        topPanel.setBorder(BorderFactory.createEmptyBorder(
            0, 15, 10, 15
        ));
        topPanel.add(formPanel, BorderLayout.CENTER);
        topPanel.add(buttonPanel, BorderLayout.SOUTH);

        add(topPanel, BorderLayout.CENTER);

        // Residents table
        String[] columns = {
            "Resident ID", "First Name", "Last Name",
            "Age", "Gender", "Address", "Contact Number"
        };

        model = new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };

        tblResidents = new JTable(model);
        tblResidents.setRowHeight(25);
        tblResidents.setAutoResizeMode(JTable.AUTO_RESIZE_OFF);

        JScrollPane scrollPane = new JScrollPane(tblResidents);
        scrollPane.setBorder(BorderFactory.createTitledBorder(
            "Registered Residents"
        ));
        scrollPane.setPreferredSize(new Dimension(900, 200));

        JPanel tablePanel = new JPanel(new BorderLayout());
        tablePanel.setBorder(BorderFactory.createEmptyBorder(
            0, 15, 15, 15
        ));
        tablePanel.add(scrollPane, BorderLayout.CENTER);

        add(tablePanel, BorderLayout.SOUTH);

        // Register button
        btnRegister.addActionListener(e -> registerResident());

        // Clear button
        btnClear.addActionListener(e -> clearForm());

        // Delete button
        btnDelete.addActionListener(e -> deleteResident());
    }

    private void registerResident() {
        String id = txtResidentID.getText().trim();
        String firstName = txtFirstName.getText().trim();
        String lastName = txtLastName.getText().trim();
        String ageText = txtAge.getText().trim();
        String gender = cmbGender.getSelectedItem().toString();
        String address = txtAddress.getText().trim();
        String contact = txtContact.getText().trim();

        // Check for empty fields
        if (id.isEmpty() || firstName.isEmpty()
                || lastName.isEmpty() || ageText.isEmpty()
                || address.isEmpty() || contact.isEmpty()) {

            JOptionPane.showMessageDialog(
                this,
                "Please fill in all fields.",
                "Missing Information",
                JOptionPane.WARNING_MESSAGE
            );
            return;
        }

        // Validate age
        int age;

        try {
            age = Integer.parseInt(ageText);

            if (age < 1 || age > 120) {
                JOptionPane.showMessageDialog(
                    this, "Age must be between 1 and 120."
                );
                return;
            }

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(
                this, "Please enter a valid age."
            );
            return;
        }

        // Validate names
        if (!firstName.matches("[a-zA-Z .'-]+")
                || !lastName.matches("[a-zA-Z .'-]+")) {
            JOptionPane.showMessageDialog(
                this, "First and last names must contain valid letters."
            );
            return;
        }

        // Validate contact number
        if (!contact.matches("[0-9]{10,11}")) {
            JOptionPane.showMessageDialog(
                this,
                "Contact number must contain 10 or 11 digits."
            );
            return;
        }

        // Prevent duplicate resident IDs
        for (int i = 0; i < model.getRowCount(); i++) {
            if (model.getValueAt(i, 0).toString().equalsIgnoreCase(id)) {
                JOptionPane.showMessageDialog(
                    this, "Resident ID already exists."
                );
                return;
            }
        }

        // Add resident to the table
        model.addRow(new Object[]{
            id, firstName, lastName, age,
            gender, address, contact
        });

        JOptionPane.showMessageDialog(
            this,
            "Resident registered successfully!",
            "Registration Complete",
            JOptionPane.INFORMATION_MESSAGE
        );

        clearForm();
    }

    private void clearForm() {
        txtResidentID.setText("");
        txtFirstName.setText("");
        txtLastName.setText("");
        txtAge.setText("");
        txtAddress.setText("");
        txtContact.setText("");
        cmbGender.setSelectedIndex(0);
        txtResidentID.requestFocus();
    }

    private void deleteResident() {
        int selectedRow = tblResidents.getSelectedRow();

        if (selectedRow == -1) {
            JOptionPane.showMessageDialog(
                this, "Please select a resident to delete."
            );
            return;
        }

        int confirm = JOptionPane.showConfirmDialog(
            this,
            "Are you sure you want to delete this resident?",
            "Confirm Delete",
            JOptionPane.YES_NO_OPTION
        );

        if (confirm == JOptionPane.YES_OPTION) {
            model.removeRow(selectedRow);

            JOptionPane.showMessageDialog(
                this, "Resident deleted successfully."
            );
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new ResidentsRegistrationSystem().setVisible(true);
      });
    }
}
