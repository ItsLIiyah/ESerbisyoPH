//resident Class
public class Resident {

    // Variables used to store resident information
    private String residentID;
    private String firstName;
    private String lastName;
    private int age;
    private String gender;
    private String address;
    private String contactNumber;

    // Constructor used to receive and store resident information
    public Resident(String residentID, String firstName,
            String lastName, int age, String gender,
            String address, String contactNumber) {

        this.residentID = residentID;
        this.firstName = firstName;
        this.lastName = lastName;
        this.age = age;
        this.gender = gender;
        this.address = address;
        this.contactNumber = contactNumber;
    }

    // Returns the Resident ID
    public String getResidentID() {
        return residentID;
    }

    // Returns the first name
    public String getFirstName() {
        return firstName;
    }

    // Returns the last name
    public String getLastName() {
        return lastName;
    }

    // Returns the age
    public int getAge() {
        return age;
    }

    // Returns the gender
    public String getGender() {
        return gender;
    }

    // Returns the address
    public String getAddress() {
        return address;
    }

    // Returns the contact number
    public String getContactNumber() {
        return contactNumber;
    }

    // Updates the resident's personal information
    public void updateResident(String firstName, String lastName,
            int age, String gender, String address,
            String contactNumber) {

        this.firstName = firstName;
        this.lastName = lastName;
        this.age = age;
        this.gender = gender;
        this.address = address;
        this.contactNumber = contactNumber;
    }
}

//back-end
// Import ArrayList to store resident records
import java.util.ArrayList;

public class ResidentBackend {

    // Creates an ArrayList for storing residents
    private ArrayList<Resident> residents = new ArrayList<>();

    // Searches for a resident using their ID
    public Resident searchResident(String id) {

        // Goes through every resident in the ArrayList
        for (Resident r : residents) {

            // Checks if the ID matches
            if (r.getResidentID().equalsIgnoreCase(id)) {

                // Returns the resident if found
                return r;
            }
        }

        // Returns null if the resident does not exist
        return null;
    }

    // Adds a new resident to the ArrayList
    public boolean addResident(Resident resident) {

        // Checks if the Resident ID already exists
        if (searchResident(resident.getResidentID()) != null) {
            return false;
        }

        // Adds the new resident if the ID is available
        residents.add(resident);

        return true;
    }

    // Returns all registered residents
    public ArrayList<Resident> getResidents() {
        return residents;
    }

    // Updates an existing resident's information
    public boolean updateResident(Resident resident) {

        // Finds the resident using their ID
        Resident oldResident = searchResident(
                resident.getResidentID());

        // Checks if the resident exists
        if (oldResident == null) {
            return false;
        }

        // Updates the resident's information
        oldResident.updateResident(
                resident.getFirstName(),
                resident.getLastName(),
                resident.getAge(),
                resident.getGender(),
                resident.getAddress(),
                resident.getContactNumber()
        );

        return true;
    }

    // Deletes a resident using their ID
    public boolean deleteResident(String id) {

        // Finds the resident before deleting
        Resident resident = searchResident(id);

        // Checks if the resident exists
        if (resident == null) {
            return false;
        }

        // Removes the resident from the ArrayList
        residents.remove(resident);

        return true;
    }
}

//front-end
// Import Swing components for the graphical interface
import javax.swing.*;

// Import table model for displaying resident records
import javax.swing.table.DefaultTableModel;

// Import AWT for layouts, fonts, and dimensions
import java.awt.*;

public class ResidentsRegistrationSystem extends JFrame {

    // Connect the frontend to the backend
    ResidentBackend backend = new ResidentBackend();

    // Declare text fields for resident information
    JTextField txtID, txtFirstName, txtLastName;
    JTextField txtAge, txtAddress, txtContact;
    JTextField txtSearch;

    // Declare dropdown for selecting gender
    JComboBox<String> cmbGender;

    // Declare table and its model
    JTable tblResidents;
    DefaultTableModel model;

    // Constructor: Creates the main window
    public ResidentsRegistrationSystem() {

        // Set the window title
        setTitle("Residents Registration System");

        // Set the window size
        setSize(1000, 700);

        // Close the program when the window is closed
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        // Place the window in the center of the screen
        setLocationRelativeTo(null);

        // Set the main layout
        setLayout(new BorderLayout(10, 10));

        // Create the heading of the system
        JLabel heading = new JLabel(
                "RESIDENTS REGISTRATION SYSTEM",
                SwingConstants.CENTER);

        // Set the heading font
        heading.setFont(new Font("Arial", Font.BOLD, 24));

        // Add heading to the top of the window
        add(heading, BorderLayout.NORTH);

        // Create the registration form panel
        JPanel formPanel = new JPanel(new GridLayout(7, 2, 10, 10));

        // Add a title to the form
        formPanel.setBorder(
                BorderFactory.createTitledBorder("Resident Information"));

        // Create text fields for resident information
        txtID = new JTextField();
        txtFirstName = new JTextField();
        txtLastName = new JTextField();
        txtAge = new JTextField();
        txtAddress = new JTextField();
        txtContact = new JTextField();

        // Create gender dropdown options
        cmbGender = new JComboBox<>(
                new String[]{"Male", "Female", "Others"});

        // Add labels and input fields to the form
        addField(formPanel, "Resident ID:", txtID);
        addField(formPanel, "First Name:", txtFirstName);
        addField(formPanel, "Last Name:", txtLastName);
        addField(formPanel, "Age:", txtAge);
        addField(formPanel, "Gender:", cmbGender);
        addField(formPanel, "Address:", txtAddress);
        addField(formPanel, "Contact Number:", txtContact);

        // Create buttons for the system
        JButton btnRegister = new JButton("Register");
        JButton btnUpdate = new JButton("Update");
        JButton btnDelete = new JButton("Delete");
        JButton btnClear = new JButton("Clear");

        // Create a panel for the buttons
        JPanel buttonPanel = new JPanel();

        // Add buttons to the panel
        buttonPanel.add(btnRegister);
        buttonPanel.add(btnUpdate);
        buttonPanel.add(btnDelete);
        buttonPanel.add(btnClear);

        // Create the search text field
        txtSearch = new JTextField(15);

        // Create search and show all buttons
        JButton btnSearch = new JButton("Search");
        JButton btnShowAll = new JButton("Show All");

        // Create the search panel
        JPanel searchPanel = new JPanel();

        // Add search components to the panel
        searchPanel.add(new JLabel("Search Resident ID:"));
        searchPanel.add(txtSearch);
        searchPanel.add(btnSearch);
        searchPanel.add(btnShowAll);

        // Combine the form and button panels
        JPanel topPanel = new JPanel(new BorderLayout(10, 10));

        // Add spacing around the panel
        topPanel.setBorder(
                BorderFactory.createEmptyBorder(10, 15, 10, 15));

        // Place the form in the center
        topPanel.add(formPanel, BorderLayout.CENTER);

        // Place the buttons at the bottom
        topPanel.add(buttonPanel, BorderLayout.SOUTH);

        // Create column names for the resident table
        String[] columns = {
            "Resident ID", "First Name", "Last Name",
            "Age", "Gender", "Address", "Contact Number"
        };

        // Create the table model using the column names
        model = new DefaultTableModel(columns, 0) {

            // Prevent users from directly editing table cells
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };

        // Create the resident table
        tblResidents = new JTable(model);

        // Set the height of each table row
        tblResidents.setRowHeight(25);

        // Add a scroll bar to the table
        JScrollPane scrollPane = new JScrollPane(tblResidents);

        // Add a title to the table
        scrollPane.setBorder(
                BorderFactory.createTitledBorder("Registered Residents"));

        // Set the preferred table size
        scrollPane.setPreferredSize(new Dimension(950, 280));

        // Create the center panel
        JPanel centerPanel = new JPanel(new BorderLayout(10, 10));

        // Add the form to the top of the center panel
        centerPanel.add(topPanel, BorderLayout.NORTH);

        // Add the search panel below the form
        centerPanel.add(searchPanel, BorderLayout.CENTER);

        // Add the resident table at the bottom
        centerPanel.add(scrollPane, BorderLayout.SOUTH);

        // Add the main panel to the window
        add(centerPanel, BorderLayout.CENTER);

        // Connect each button to its corresponding method
        btnRegister.addActionListener(e -> registerResident());
        btnUpdate.addActionListener(e -> updateResident());
        btnDelete.addActionListener(e -> deleteResident());
        btnClear.addActionListener(e -> clearForm());

        // Search button gets the ID from the search field
        btnSearch.addActionListener(e ->
                searchResident(txtSearch.getText()));

        // Show All button displays all resident records
        btnShowAll.addActionListener(e -> displayResidents());

        // Listen when a table row is selected
        tblResidents.getSelectionModel().addListSelectionListener(e -> {

            // Check if the selection process is finished
            if (!e.getValueIsAdjusting()) {

                // Get the selected row number
                int row = tblResidents.getSelectedRow();

                // Check if a row is selected
                if (row != -1) {

                    // Copy table information into the text fields
                    txtID.setText(model.getValueAt(row, 0).toString());
                    txtFirstName.setText(model.getValueAt(row, 1).toString());
                    txtLastName.setText(model.getValueAt(row, 2).toString());
                    txtAge.setText(model.getValueAt(row, 3).toString());

                    // Set the selected gender
                    cmbGender.setSelectedItem(model.getValueAt(row, 4));

                    txtAddress.setText(model.getValueAt(row, 5).toString());
                    txtContact.setText(model.getValueAt(row, 6).toString());
                }
            }
        });

        // Display resident records when the program starts
        displayResidents();
    }

    // Method for adding labels and input fields to the form
    private void addField(JPanel panel, String label, JComponent field) {

        // Add the label
        panel.add(new JLabel(label));

        // Add the input field
        panel.add(field);
    }

    // Get information from the form and create a Resident object
    private Resident getResidentFromForm() {

        return new Resident(
                txtID.getText().trim(),
                txtFirstName.getText().trim(),
                txtLastName.getText().trim(),
                Integer.parseInt(txtAge.getText().trim()),
                cmbGender.getSelectedItem().toString(),
                txtAddress.getText().trim(),
                txtContact.getText().trim()
        );
    }

    // Method for checking if the form inputs are valid
    private boolean validateForm() {

        // Check if any required field is empty
        if (txtID.getText().trim().isEmpty()
                || txtFirstName.getText().trim().isEmpty()
                || txtLastName.getText().trim().isEmpty()
                || txtAge.getText().trim().isEmpty()
                || txtAddress.getText().trim().isEmpty()
                || txtContact.getText().trim().isEmpty()) {

            // Show an error message
            JOptionPane.showMessageDialog(this,
                    "Please fill in all fields.");

            return false;
        }

        // Check if first and last names contain valid characters
        if (!txtFirstName.getText().trim().matches("[a-zA-Z .'-]+")
                || !txtLastName.getText().trim().matches("[a-zA-Z .'-]+")) {

            JOptionPane.showMessageDialog(this,
                    "Please enter valid names.");

            return false;
        }

        // Check if age is a valid number
        try {

            int age = Integer.parseInt(txtAge.getText().trim());

            // Check if age is within the allowed range
            if (age < 1 || age > 120) {

                JOptionPane.showMessageDialog(this,
                        "Age must be between 1 and 120.");

                return false;
            }

        } catch (NumberFormatException e) {

            // Show an error if age is not a number
            JOptionPane.showMessageDialog(this,
                    "Please enter a valid age.");

            return false;
        }

        // Check if contact number contains 10 or 11 digits
        if (!txtContact.getText().trim().matches("[0-9]{10,11}")) {

            JOptionPane.showMessageDialog(this,
                    "Contact number must contain 10 or 11 digits.");

            return false;
        }

        // Return true if all inputs are valid
        return true;
    }

    // Method for registering a new resident
    private void registerResident() {

        // Check the form before registering
        if (!validateForm()) {
            return;
        }

        // Get the resident information
        Resident resident = getResidentFromForm();

        // Send the information to the backend
        if (backend.addResident(resident)) {

            // Show success message
            JOptionPane.showMessageDialog(this,
                    "Resident registered successfully!");

            // Refresh the table
            displayResidents();

            // Clear the form
            clearForm();

        } else {

            // Show message if the ID already exists
            JOptionPane.showMessageDialog(this,
                    "Resident ID already exists.");
        }
    }

    // Method for adding resident information to the table
    private void addResidentToTable(Resident r) {

        // Add resident details as a new table row
        model.addRow(new Object[]{
            r.getResidentID(),
            r.getFirstName(),
            r.getLastName(),
            r.getAge(),
            r.getGender(),
            r.getAddress(),
            r.getContactNumber()
        });
    }

    // Method for displaying all registered residents
    private void displayResidents() {

        // Remove old rows before displaying updated records
        model.setRowCount(0);

        // Get all residents from the backend
        for (Resident r : backend.getResidents()) {

            // Add each resident to the table
            addResidentToTable(r);
        }
    }

    // Method for searching a resident using their ID
    private void searchResident(String id) {

        // Check if the search field is empty
        if (id.trim().isEmpty()) {

            JOptionPane.showMessageDialog(this,
                    "Please enter a Resident ID.");

            return;
        }

        // Search for the resident in the backend
        Resident resident = backend.searchResident(id.trim());

        // Clear the current table records
        model.setRowCount(0);

        // Check if the resident was found
        if (resident != null) {

            // Display the found resident
            addResidentToTable(resident);

        } else {

            // Show message if no resident was found
            JOptionPane.showMessageDialog(this,
                    "Resident not found.");

            // Display all residents again
            displayResidents();
        }
    }

    // Method for updating resident information
    private void updateResident() {

        // Validate the form before updating
        if (!validateForm()) {
            return;
        }

        // Get the updated information
        Resident resident = getResidentFromForm();

        // Send the updated information to the backend
        if (backend.updateResident(resident)) {

            // Show success message
            JOptionPane.showMessageDialog(this,
                    "Resident updated successfully!");

            // Refresh the table
            displayResidents();

            // Clear the form
            clearForm();

        } else {

            // Show message if the ID does not exist
            JOptionPane.showMessageDialog(this,
                    "Resident ID not found.");
        }
    }

    // Method for deleting a resident
    private void deleteResident() {

        // Get the Resident ID from the form
        String id = txtID.getText().trim();

        // Check if an ID was entered
        if (id.isEmpty()) {

            JOptionPane.showMessageDialog(this,
                    "Please select a resident first.");

            return;
        }

        // Ask the user to confirm the deletion
        int confirm = JOptionPane.showConfirmDialog(
                this,
                "Are you sure you want to delete this resident?",
                "Confirm Delete",
                JOptionPane.YES_NO_OPTION);

        // Continue only if the user clicks Yes
        if (confirm == JOptionPane.YES_OPTION) {

            // Send the delete request to the backend
            if (backend.deleteResident(id)) {

                // Show success message
                JOptionPane.showMessageDialog(this,
                        "Resident deleted successfully!");

                // Refresh the table
                displayResidents();

                // Clear the form
                clearForm();

            } else {

                // Show message if resident does not exist
                JOptionPane.showMessageDialog(this,
                        "Resident not found.");
            }
        }
    }

    // Method for clearing all form fields
    private void clearForm() {

        // Clear text fields
        txtID.setText("");
        txtFirstName.setText("");
        txtLastName.setText("");
        txtAge.setText("");
        txtAddress.setText("");
        txtContact.setText("");

        // Reset gender dropdown to its first option
        cmbGender.setSelectedIndex(0);

        // Remove the selected table row
        tblResidents.clearSelection();

        // Place the cursor in the Resident ID field
        txtID.requestFocus();
    }

    // Main method: Starts the program
    public static void main(String[] args) {

        // Run the interface safely using SwingUtilities
        SwingUtilities.invokeLater(() -> {

            // Create and display the main window
            new ResidentsRegistrationSystem().setVisible(true);
        });
    }
}
