package com.mycompany.eserbisyoph;

import java.awt.*;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

public class ESerbisyoPH extends JFrame {

    private JTextField txtName, txtAge, txtAddress, txtEmail, txtSearch;
    private JComboBox<String> cmbSex, cmbStatus, cmbEmployment;

    private JTable table;
    private DefaultTableModel model;

    public ESerbisyoPH() {

        setTitle("ESerbisyoPH - Reports and Analytics");
        setSize(1100, 650);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout(10, 10));

        JLabel heading = new JLabel(
                "ESERBISYOPH REPORTS AND ANALYTICS",
                SwingConstants.CENTER);

        heading.setFont(new Font("Arial", Font.BOLD, 24));
        add(heading, BorderLayout.NORTH);

        JPanel formPanel = new JPanel(new GridLayout(7, 2, 10, 10));
        formPanel.setBorder(
                BorderFactory.createTitledBorder("Citizen Information"));

        txtName = new JTextField();
        txtAge = new JTextField();
        txtAddress = new JTextField();
        txtEmail = new JTextField();

        cmbSex = new JComboBox<>(
                new String[]{"Male", "Female"});

        cmbStatus = new JComboBox<>(
                new String[]{"Single", "Married", "Widowed"});

        cmbEmployment = new JComboBox<>(
                new String[]{
                    "Employed",
                    "Unemployed",
                    "Student"
                });

        formPanel.add(new JLabel("Full Name:"));
        formPanel.add(txtName);

        formPanel.add(new JLabel("Age:"));
        formPanel.add(txtAge);

        formPanel.add(new JLabel("Sex:"));
        formPanel.add(cmbSex);

        formPanel.add(new JLabel("Civil Status:"));
        formPanel.add(cmbStatus);

        formPanel.add(new JLabel("Address:"));
        formPanel.add(txtAddress);

        formPanel.add(new JLabel("Email Address:"));
        formPanel.add(txtEmail);

        formPanel.add(new JLabel("Employment Status:"));
        formPanel.add(cmbEmployment);

        JPanel buttonPanel = new JPanel();

        JButton btnRegister = new JButton("Register");
        JButton btnUpdate = new JButton("Update");
        JButton btnDelete = new JButton("Delete");
        JButton btnClear = new JButton("Clear");

        buttonPanel.add(btnRegister);
        buttonPanel.add(btnUpdate);
        buttonPanel.add(btnDelete);
        buttonPanel.add(btnClear);

        JPanel leftPanel = new JPanel(new BorderLayout());

        leftPanel.add(formPanel, BorderLayout.CENTER);
        leftPanel.add(buttonPanel, BorderLayout.SOUTH);

        add(leftPanel, BorderLayout.WEST);

        String[] columns = {
            "Name",
            "Age",
            "Sex",
            "Civil Status",
            "Address",
            "Email",
            "Employment"
        };

        model = new DefaultTableModel(columns, 0);

        table = new JTable(model);

        JScrollPane scrollPane = new JScrollPane(table);

        add(scrollPane, BorderLayout.CENTER);

        JPanel searchPanel = new JPanel();

        txtSearch = new JTextField(15);

        JButton btnSearch = new JButton("Search");
        JButton btnShowAll = new JButton("Show All");

        searchPanel.add(new JLabel("Search Name:"));
        searchPanel.add(txtSearch);
        searchPanel.add(btnSearch);
        searchPanel.add(btnShowAll);

        add(searchPanel, BorderLayout.SOUTH);

        btnRegister.addActionListener(e -> registerCitizen());

        btnUpdate.addActionListener(e -> updateCitizen());

        btnDelete.addActionListener(e -> deleteCitizen());

        btnClear.addActionListener(e -> clearFields());

        btnSearch.addActionListener(e -> searchCitizen());

        btnShowAll.addActionListener(e -> showAllRecords());

        table.getSelectionModel().addListSelectionListener(e -> {

            if (!e.getValueIsAdjusting()) {

                int row = table.getSelectedRow();

                if (row != -1) {

                    txtName.setText(
                            model.getValueAt(row, 0).toString());

                    txtAge.setText(
                            model.getValueAt(row, 1).toString());

                    cmbSex.setSelectedItem(
                            model.getValueAt(row, 2).toString());

                    cmbStatus.setSelectedItem(
                            model.getValueAt(row, 3).toString());

                    txtAddress.setText(
                            model.getValueAt(row, 4).toString());

                    txtEmail.setText(
                            model.getValueAt(row, 5).toString());

                    cmbEmployment.setSelectedItem(
                            model.getValueAt(row, 6).toString());
                }
            }
        });
    }

    private void registerCitizen() {

        if (txtName.getText().trim().isEmpty()
                || txtAge.getText().trim().isEmpty()) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please complete all fields.");

            return;
        }

        try {

            int age =
                    Integer.parseInt(txtAge.getText());

            model.addRow(new Object[]{
                txtName.getText(),
                age,
                cmbSex.getSelectedItem(),
                cmbStatus.getSelectedItem(),
                txtAddress.getText(),
                txtEmail.getText(),
                cmbEmployment.getSelectedItem()
            });

            JOptionPane.showMessageDialog(
                    this,
                    "Citizen Registered Successfully!");

            clearFields();

        } catch (NumberFormatException ex) {

            JOptionPane.showMessageDialog(
                    this,
                    "Invalid Age.");
        }
    }

    private void updateCitizen() {

        int row = table.getSelectedRow();

        if (row == -1) {

            JOptionPane.showMessageDialog(
                    this,
                    "Select a record first.");

            return;
        }

        model.setValueAt(txtName.getText(), row, 0);
        model.setValueAt(txtAge.getText(), row, 1);
        model.setValueAt(cmbSex.getSelectedItem(), row, 2);
        model.setValueAt(cmbStatus.getSelectedItem(), row, 3);
        model.setValueAt(txtAddress.getText(), row, 4);
        model.setValueAt(txtEmail.getText(), row, 5);
        model.setValueAt(cmbEmployment.getSelectedItem(), row, 6);

        JOptionPane.showMessageDialog(
                this,
                "Record Updated Successfully!");
    }

    private void deleteCitizen() {

        int row = table.getSelectedRow();

        if (row == -1) {

            JOptionPane.showMessageDialog(
                    this,
                    "Select a record first.");

            return;
        }

        model.removeRow(row);

        JOptionPane.showMessageDialog(
                this,
                "Record Deleted Successfully!");

        clearFields();
    }

    private void searchCitizen() {

        String keyword =
                txtSearch.getText().trim().toLowerCase();

        if (keyword.isEmpty()) {
            return;
        }

        for (int i = 0; i < model.getRowCount(); i++) {

            String name =
                    model.getValueAt(i, 0)
                            .toString()
                            .toLowerCase();

            if (name.contains(keyword)) {

                table.setRowSelectionInterval(i, i);

                return;
            }
        }

        JOptionPane.showMessageDialog(
                this,
                "Record Not Found.");
    }

    private void showAllRecords() {

        table.clearSelection();
        txtSearch.setText("");
    }

    private void clearFields() {

        txtName.setText("");
        txtAge.setText("");
        txtAddress.setText("");
        txtEmail.setText("");

        cmbSex.setSelectedIndex(0);
        cmbStatus.setSelectedIndex(0);
        cmbEmployment.setSelectedIndex(0);

        table.clearSelection();
    }

    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {
            new ESerbisyoPH().setVisible(true);
        });
    }
}
